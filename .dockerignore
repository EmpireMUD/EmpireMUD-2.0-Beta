.git
.gitignore

# Host build output must never become input to the container build.
config.cache
config.log
config.status
src/*.o
src/.accepted
bin/*
!bin/README
lib/world/wld/map
lib/world/wld/read_map
*.dSYM

# Runtime output belongs in named volumes.
data/game_data
data/map*.txt
log/*
!log/.gitignore
!log/README
syslog
syslog.*

# Local editor and OS files.
*~
.DS_Store
